# =============================================================================
# Jonoshheba AI — Root Local Infrastructure & Shared Environment Variables
# Copy to .env (git-ignored). Never commit real keys or secrets.
# =============================================================================

NODE_ENV=development
APP_ENV=development
TZ=Asia/Dhaka

# --- PostgreSQL 16 (+ pgvector, pg_trgm, unaccent) ---
POSTGRES_USER=jonoshheba
POSTGRES_PASSWORD=jonoshheba_dev_password_change_me
POSTGRES_DB=jonoshheba
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jonoshheba:jonoshheba_dev_password_change_me@localhost:5432/jonoshheba?schema=public

# --- Redis 7 ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=jonoshheba_minio
MINIO_ROOT_PASSWORD=jonoshheba_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=jonoshheba-dev
S3_ACCESS_KEY_ID=jonoshheba_minio
S3_SECRET_ACCESS_KEY=jonoshheba_minio_dev_password
S3_FORCE_PATH_STYLE=true

# --- Mailpit (dev SMTP) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@jonoshheba.local

# --- Observability (OpenTelemetry / Grafana / Loki / Tempo / Prometheus) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
MLFLOW_PORT=5000

# --- Optional Profiles ---
OPENSEARCH_PORT=9200
OLLAMA_PORT=11434

# --- Service Ports ---
API_PORT=4000
AI_PORT=8000
WEB_PORT=3000
ADMIN_PORT=3001

# --- Security, CORS, JWT & Webhook Secrets (ROTATE IN EVERY ENVIRONMENT) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,jonoshheba://
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret
AI_SERVICE_JWT_SECRET=replace_with_64_char_random_hex_internal_ai_secret
CHAT_SESSION_SECRET=replace_with_64_char_random_hex_chat_session_secret
WEBHOOK_HMAC_SECRET=replace_with_64_char_random_hex_webhook_hmac_secret
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REPLAY_WINDOW_SECONDS=300
