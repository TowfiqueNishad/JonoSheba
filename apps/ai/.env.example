# =============================================================================
# Jonoshheba AI Service (apps/ai — Python 3.12 + FastAPI)
# Internal-only service called by apps/api & apps/workers.
# Validated strictly at boot with pydantic-settings (fail fast).
# =============================================================================

APP_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000
APP_TIMEZONE=Asia/Dhaka

# --- Internal Service Auth ---
AI_SERVICE_JWT_SECRET=dev_only_replace_with_32_byte_internal_ai_shared_secret

# --- LLM & Embeddings (provider-agnostic) ---
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL_FAST=qwen2.5:7b-instruct
LLM_MODEL_STRONG=qwen2.5:14b-instruct
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cpu

# --- Data & MLOps ---
DATABASE_URL=postgresql://jonoshheba:jonoshheba_dev_password_change_me@localhost:5432/jonoshheba
REDIS_URL=redis://localhost:6379/1
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jonoshheba-dev
S3_ACCESS_KEY_ID=jonoshheba_minio
S3_SECRET_ACCESS_KEY=jonoshheba_minio_dev_password
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
