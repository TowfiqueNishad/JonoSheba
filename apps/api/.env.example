# =============================================================================
# Jonoshheba API (apps/api — NestJS) Environment Configuration
# Validated strictly at boot with Zod (fail fast). Copy to .env for local dev.
# =============================================================================

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
APP_TIMEZONE=Asia/Dhaka
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- PostgreSQL & Redis ---
DATABASE_URL=postgresql://jonoshheba:jonoshheba_dev_password_change_me@localhost:5432/jonoshheba?schema=public
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=jonoshheba-dev
S3_ACCESS_KEY_ID=jonoshheba_minio
S3_SECRET_ACCESS_KEY=jonoshheba_minio_dev_password

# --- Auth & JWT (NEVER reuse dev defaults in staging/prod) ---
JWT_ISSUER=jonoshheba-api
JWT_AUDIENCE=jonoshheba-clients
JWT_ACCESS_SECRET=dev_only_replace_with_32_byte_random_access_secret_key
JWT_REFRESH_SECRET=dev_only_replace_with_32_byte_random_refresh_secret_key
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Internal AI Service (apps/ai) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_JWT_SECRET=dev_only_replace_with_32_byte_internal_ai_shared_secret

# --- Notifications: SMS, Email, Web Push (VAPID), Mobile Push (FCM/Expo) ---
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=JONOSHHEBA
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@jonoshheba.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@jonoshheba.local
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Bot Protection & Observability ---
TURNSTILE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
