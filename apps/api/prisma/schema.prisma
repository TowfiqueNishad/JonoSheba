model KbDocument {
  id        String      @id @default(uuid(7)) @db.Uuid
  sourceId  String      @map("source_id") @db.Uuid
  title     String
  lang      String      @default("bn") @db.VarChar(8)
  agency    String
  docType   String      @map("doc_type") @db.VarChar(32)
  version   Int         @default(1)
  status    KbDocStatus @default(pending)
  validFrom DateTime?   @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime?   @map("valid_to") @db.Timestamptz(6)
  checksum  String      @db.VarChar(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  chunks KbChunk[]

  @@unique([sourceId, version])
  @@index([status, validTo])
  @@index([checksum])
  @@map("kb_documents")
  @@schema("ai")
}

model KbChunk {
  id          String                       @id @default(uuid(7)) @db.Uuid
  documentId  String                       @map("document_id") @db.Uuid
  ordinal     Int
  text        String
  lang        String                       @default("bn") @db.VarChar(8)
  tokens      Int
  headingPath String?                      @map("heading_path")
  embedding   Unsupported("vector(1024)")?
  tsv         Unsupported("tsvector")?
  metadata    Json                         @default("{}")
  isExpired   Boolean                      @default(false) @map("is_expired")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([isExpired])
  @@map("kb_chunks")
  @@schema("ai")
}

model Conversation {
  id        String    @id @default(uuid(7)) @db.Uuid
