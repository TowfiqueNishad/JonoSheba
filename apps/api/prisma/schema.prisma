/// Admin user (owner + staff). Separate from citizen User model.
model AdminUser {
  id             String          @id @default(uuid(7)) @db.Uuid
  email          String          @unique @db.VarChar(254)
  passwordHash   String          @db.VarChar(256)
  totpSecret     String?         @map("totp_secret") @db.VarChar(256)
  totpEnabled    Boolean         @default(false) @map("totp_enabled")
  passkeyEnabled Boolean         @default(false) @map("passkey_enabled")
  role           String          @default("owner") @db.VarChar(32)
  status         String          @default("active") @db.VarChar(32)
  failedAttempts Int             @default(0) @map("failed_attempts")
  lockedUntil    DateTime?       @map("locked_until") @db.Timestamptz(6)
  lastLoginAt    DateTime?       @map("last_login_at") @db.Timestamptz(6)
  ipAllowlist    String[]        @map("ip_allowlist") @db.VarChar(45)
  recoveryCodes  String[]        @map("recovery_codes") @db.VarChar(128)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]

  @@map("admin_users")
  @@schema("admin")
}

/// Admin session tokens (separate from citizen sessions).
model AdminSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  ipHash        String?   @map("ip_hash") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  mfaVerified   Boolean   @default(false) @map("mfa_verified")
  reauthedAt    DateTime? @map("reauthed_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([expiresAt])
  @@map("admin_sessions")
  @@schema("admin")
}

/// Append-only admin action audit log.
model AdminAuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  action      String    @db.VarChar(100)
  targetType  String?   @map("target_type") @db.VarChar(64)
  targetId    String?   @map("target_id")
  ipHash      String?   @map("ip_hash") @db.VarChar(64)
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
  @@schema("admin")
}

model FeatureFlag {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String
  enabled     Boolean  @default(false)
  rules       Json     @default("{}")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
  @@schema("admin")
}

model ProviderHealthCheck {
  id           String   @id @default(uuid(7)) @db.Uuid
  providerId   String   @map("provider_id") @db.Uuid
  status       String   @db.VarChar(24)
  latencyMs    Int?     @map("latency_ms")
  errorRate    Float?   @map("error_rate")
  circuitState String   @default("closed") @map("circuit_state") @db.VarChar(24)
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([providerId, checkedAt])
  @@map("provider_health_checks")
  @@schema("admin")
}

// =============================================================================
// 9. AUDIT SCHEMA (Append-Only Audit Logs, Transactional Outbox, Privacy Requests)
// =============================================================================

/// Append-only audit log (UPDATE and DELETE rejected at DB trigger level).
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(40)
  action       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id")
  beforeDiff   Json?    @map("before_diff")
  afterDiff    Json?    @map("after_diff")
  ipHash       String?  @map("ip_hash")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

/// Transactional outbox for event-driven inter-module messaging.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  payload       Json
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
  @@schema("audit")
}

model DataExportRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      DataRequestStatus @default(requested)
  objectKey   String?           @map("object_key")
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@map("data_export_requests")
  @@schema("audit")
}

model DeletionRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      DataRequestStatus @default(requested)
  requestedAt DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  graceUntil  DateTime          @map("grace_until") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([graceUntil])
  @@map("deletion_requests")
  @@schema("audit")
}
