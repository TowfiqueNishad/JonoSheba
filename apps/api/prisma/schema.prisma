// =============================================================================
// Jonoshheba AI (জনসেবা AI) — Complete PostgreSQL 16 Multi-Schema Prisma Model
// Bounded-context schemas:
//   identity, catalogue, transport, notify, cases, opportunities, ai, admin, audit
// Rules R1–R11 enforced via enums, mandatory provenance (sourceId/trustLabel),
// user-scoped ownership columns (RLS enforced in SQL migration), and append-only audit.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["identity", "catalogue", "transport", "notify", "cases", "opportunities", "ai", "admin", "audit"]
  extensions = [vector, pg_trgm, unaccent, pgcrypto]
}

// =============================================================================
// SHARED DOMAIN ENUMS (per schema where used)
// =============================================================================

enum UserStatus {
  active
  suspended
  pending_deletion
  deleted

  @@schema("identity")
}

enum Platform {
  web
  ios
  android

  @@schema("identity")
}

enum OrgStatus {
  pending
  verified
  suspended

  @@schema("identity")
}

enum MalwareScanStatus {
  pending
  clean
  infected
  failed

  @@schema("identity")
}

enum OcrStatus {
  not_requested
  pending
  completed
  failed

  @@schema("identity")
}

enum TrustLabel {
  OFFICIAL_SOURCE
  VERIFIED_BY_JONOSHHEBA
  PARTNER_PROVIDED
  COMMUNITY_REPORT
  UNAVAILABLE_STALE

  @@schema("catalogue")
}

enum ContentStatus {
  draft
  in_review
  published
  archived

  @@schema("catalogue")
}

enum NoticeKind {
  circular
  deadline
  outage
  disaster
  health
  exam

  @@schema("catalogue")
}

enum FacilityType {
  hospital
  clinic
  diagnostic
  shelter
  police
  fire
  utility_office

  @@schema("catalogue")
}

enum ContentReportStatus {
  open
  in_review
  resolved
  dismissed

  @@schema("catalogue")
}

enum ReminderStatus {
  scheduled
  sent
  cancelled

  @@schema("catalogue")
}

enum TransportMode {
  train
  bus
  launch
  flight
  metro

  @@schema("transport")
}

enum IntegrationType {
  OFFICIAL_API
  PARTNER_FEED
  PERMITTED_FEED
  MANUAL
  LINK_ONLY
  MOCK

  @@schema("transport")
}

enum ProviderStatus {
  active
  degraded
  disabled

  @@schema("transport")
}

enum WatchStatus {
  active
  matched
  notified
  paused
  expired
  cancelled
  error

  @@schema("transport")
}

enum AvailabilityState {
  AVAILABLE
  LIMITED
  SOLD_OUT
  UNKNOWN_STALE
  PROVIDER_ERROR

  @@schema("transport")
}

enum MatchQuality {
  exact
  partial

  @@schema("transport")
}

enum NotificationChannel {
  in_app
  web_push
  mobile_push
  email
  sms
  whatsapp
  ussd
  ivr

  @@schema("notify")
}

enum NotificationPriority {
  P0
  P1
  P2
  P3

  @@schema("notify")
}

enum NotificationJobStatus {
  queued
  sending
  sent
  delivered
  failed
  dlq
  suppressed

  @@schema("notify")
}

enum OpportunityTargetType {
  program
  scholarship
  job

  @@schema("opportunities")
}

enum OpportunityStatus {
  draft
  in_review
  published
  expired
  archived

  @@schema("opportunities")
}

enum CaseType {
  support
  external_complaint

  @@schema("cases")
}

enum CaseStatus {
  draft
  ready
  submitted_externally
  ref_saved
  closed

  @@schema("cases")
}

enum KbDocStatus {
  pending
  indexed
  superseded
  archived

  @@schema("ai")
}

enum MessageRole {
  user
  assistant
  system
  tool

  @@schema("ai")
}

enum DataRequestStatus {
  requested
  processing
  ready
  completed
  cancelled
  failed

  @@schema("audit")
}

// =============================================================================
// 1. IDENTITY SCHEMA
// =============================================================================

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  phoneE164    String?    @unique @map("phone_e164")
  email        String?    @unique
  passwordHash String?    @map("password_hash")
  displayName  String?    @map("display_name")
  status       UserStatus @default(active)
  locale       String     @default("bn") @db.VarChar(8)
  isGuest      Boolean    @default(false) @map("is_guest")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc String?    @map("mfa_secret_enc")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  identityProviders IdentityProvider[]
  sessions          Session[]
  userRoles         UserRole[]
  preferences       UserPreference?
  profileHints      UserProfileHint?
  consents          Consent[]
  devices           Device[]
  documents         Document[]

  @@index([status])
  @@map("users")
  @@schema("identity")
}

model IdentityProvider {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(40)
  providerUserId String    @map("provider_user_id")
  email          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identity_providers")
  @@schema("identity")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String    @map("device_id")
  platform         Platform
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model OtpChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  phoneE164   String    @map("phone_e164")
  codeHash    String    @map("code_hash")
  purpose     String    @default("login") @db.VarChar(32)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  ipHash      String?   @map("ip_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(40)
  nameBn      String   @map("name_bn")
  nameEn      String   @map("name_en")
  permissions Json     @default("[]")
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles UserRole[]

  @@map("roles")
  @@schema("identity")
}

model Organization {
  id         String    @id @default(uuid(7)) @db.Uuid
  slug       String    @unique
  nameBn     String    @map("name_bn")
  nameEn     String    @map("name_en")
  orgType    String    @map("org_type") @db.VarChar(40)
  status     OrgStatus @default(pending)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  userRoles UserRole[]

  @@map("organizations")
  @@schema("identity")
}

model UserRole {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  orgId     String?   @map("org_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, orgId])
  @@index([userId])
  @@map("user_roles")
  @@schema("identity")
}

model UserPreference {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  language             String   @default("bn") @db.VarChar(8)
  numeralStyle         String   @default("bn") @map("numeral_style") @db.VarChar(8)
  notificationChannels Json     @default("{\"in_app\":true,\"web_push\":true,\"mobile_push\":true,\"email\":false,\"sms\":false}") @map("notification_channels")
  quietHours           Json     @default("{\"enabled\":false,\"start\":\"23:00\",\"end\":\"06:00\",\"timezone\":\"Asia/Dhaka\"}") @map("quiet_hours")
  accessibility        Json     @default("{\"font_scale\":100,\"high_contrast\":false,\"voice_first\":false,\"low_data\":false}")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("identity")
}

model Consent {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  purpose     String    @db.VarChar(80)
  version     String    @db.VarChar(24)
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  ipHash      String?   @map("ip_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
  @@schema("identity")
}

/// R9: Strictly optional, consent-backed profile hints. Browsing never requires any of these.
model UserProfileHint {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  ageBand              String?   @map("age_band") @db.VarChar(32)
  ageBandConsentId     String?   @map("age_band_consent_id") @db.Uuid
  divisionId           String?   @map("division_id") @db.Uuid
  districtId           String?   @map("district_id") @db.Uuid
  upazilaId            String?   @map("upazila_id") @db.Uuid
  locationConsentId    String?   @map("location_consent_id") @db.Uuid
  occupationBand       String?   @map("occupation_band") @db.VarChar(64)
  occupationConsentId  String?   @map("occupation_consent_id") @db.Uuid
  studentLevel         String?   @map("student_level") @db.VarChar(48)
  studentConsentId     String?   @map("student_consent_id") @db.Uuid
  hasDisability        Boolean?  @map("has_disability")
  disabilityConsentId  String?   @map("disability_consent_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_hints")
  @@schema("identity")
}

model Device {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  platform    Platform
  pushToken   String    @unique @map("push_token")
  deviceLabel String?   @map("device_label")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
  @@schema("identity")
}

/// R9 & R10: Encrypted citizen documents with explicit retention_until and envelope DEK.
model Document {
  id                String            @id @default(uuid(7)) @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  objectKey         String            @unique @map("object_key")
  mime              String            @db.VarChar(128)
  size              Int
  sha256            String            @db.VarChar(64)
  documentType      String            @map("document_type") @db.VarChar(64)
  malwareScanStatus MalwareScanStatus @default(pending) @map("malware_scan_status")
  ocrStatus         OcrStatus         @default(not_requested) @map("ocr_status")
  retentionUntil    DateTime          @map("retention_until") @db.Timestamptz(6)
  encryptedDek      String            @map("encrypted_dek")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([retentionUntil])
  @@map("documents")
  @@schema("identity")
}

// =============================================================================
// 2. CATALOGUE SCHEMA (Geography, Services, Life Events, Notices, Emergency, Health, Utilities)
// =============================================================================

model Division {
  id        String   @id @default(uuid(7)) @db.Uuid
  bbsCode   String   @unique @map("bbs_code") @db.VarChar(8)
  nameBn    String   @map("name_bn")
  nameEn    String   @map("name_en")
  lat       Float?
  lng       Float?
  bbox      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  districts District[]

  @@map("divisions")
  @@schema("catalogue")
}

model District {
  id         String   @id @default(uuid(7)) @db.Uuid
  divisionId String   @map("division_id") @db.Uuid
  bbsCode    String   @unique @map("bbs_code") @db.VarChar(8)
  nameBn     String   @map("name_bn")
  nameEn     String   @map("name_en")
  lat        Float?
  lng        Float?
  bbox       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  division       Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas       Upazila[]
  serviceOffices ServiceOffice[]
  facilities     Facility[]
  utilityOutages UtilityOutage[]

  @@index([divisionId])
  @@map("districts")
  @@schema("catalogue")
}

model Upazila {
  id         String   @id @default(uuid(7)) @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  bbsCode    String   @unique @map("bbs_code") @db.VarChar(12)
  nameBn     String   @map("name_bn")
  nameEn     String   @map("name_en")
  lat        Float?
  lng        Float?
  bbox       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  district       District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  unionsWards    UnionWard[]
  serviceOffices ServiceOffice[]
  facilities     Facility[]
  utilityOutages UtilityOutage[]

  @@index([districtId])
  @@map("upazilas")
  @@schema("catalogue")
}

model UnionWard {
  id        String   @id @default(uuid(7)) @db.Uuid
  upazilaId String   @map("upazila_id") @db.Uuid
  bbsCode   String   @unique @map("bbs_code") @db.VarChar(16)
  nameBn    String   @map("name_bn")
  nameEn    String   @map("name_en")
  kind      String   @default("union") @db.VarChar(24)
  lat       Float?
  lng       Float?
  bbox      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  upazila Upazila @relation(fields: [upazilaId], references: [id], onDelete: Restrict)

  @@index([upazilaId])
  @@map("unions_wards")
  @@schema("catalogue")
}

model ServiceCategory {
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  slug      String    @unique
  nameBn    String    @map("name_bn")
  nameEn    String    @map("name_en")
  icon      String?   @db.VarChar(64)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryTree")
  services Service[]

  @@index([parentId])
  @@map("service_categories")
  @@schema("catalogue")
}

model LifeEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  slug      String        @unique
  titleBn   String        @map("title_bn")
  titleEn   String        @map("title_en")
  summaryBn String        @map("summary_bn")
  summaryEn String        @map("summary_en")
  icon      String?       @db.VarChar(64)
  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(published)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  steps LifeEventStep[]

  @@map("life_events")
  @@schema("catalogue")
}

model LifeEventStep {
  id          String   @id @default(uuid(7)) @db.Uuid
  lifeEventId String   @map("life_event_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  stepOrder   Int      @map("step_order")
  titleBn     String   @map("title_bn")
  titleEn     String   @map("title_en")
  notesBn     String?  @map("notes_bn")
  notesEn     String?  @map("notes_en")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lifeEvent LifeEvent @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([lifeEventId, stepOrder])
  @@map("life_event_steps")
  @@schema("catalogue")
}

model Agency {
  id           String    @id @default(uuid(7)) @db.Uuid
  slug         String    @unique
  nameBn       String    @map("name_bn")
  nameEn       String    @map("name_en")
  agencyType   String    @default("government") @map("agency_type") @db.VarChar(40)
  officialUrl  String?   @map("official_url")
  contactPhone String?   @map("contact_phone")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  services       Service[]
  serviceOffices ServiceOffice[]

  @@map("agencies")
  @@schema("catalogue")
}

/// R5: Provenance source registry backing all citizen-facing facts, notices, hotlines & rules.
model Source {
  id          String     @id @default(uuid(7)) @db.Uuid
  url         String
  agency      String
  sourceType  String     @map("source_type") @db.VarChar(40)
  contentHash String?    @map("content_hash") @db.VarChar(64)
  fetchedAt   DateTime?  @map("fetched_at") @db.Timestamptz(6)
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz(6)
  validFrom   DateTime?  @map("valid_from") @db.Timestamptz(6)
  validTo     DateTime?  @map("valid_to") @db.Timestamptz(6)
  reviewerId  String?    @map("reviewer_id") @db.Uuid
  trustLabel  TrustLabel @default(OFFICIAL_SOURCE) @map("trust_label")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  services       Service[]
  notices        Notice[]
  faqs           Faq[]
  hotlines       Hotline[]
  facilities     Facility[]
  utilityOutages UtilityOutage[]

  @@index([validTo])
  @@index([trustLabel])
  @@map("sources")
  @@schema("catalogue")
}

model Service {
  id               String        @id @default(uuid(7)) @db.Uuid
  slug             String        @unique
  titleBn          String        @map("title_bn")
  titleEn          String        @map("title_en")
  summaryBn        String        @map("summary_bn")
  summaryEn        String        @map("summary_en")
  descriptionMdBn  String        @map("description_md_bn")
  descriptionMdEn  String        @map("description_md_en")
  agencyId         String        @map("agency_id") @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  sourceId         String        @map("source_id") @db.Uuid
  deliveryChannels String[]      @default(["online"]) @map("delivery_channels")
  officialUrl      String        @map("official_url")
  feeInfo          Json          @default("{}") @map("fee_info")
  processingTime   String?       @map("processing_time")
  status           ContentStatus @default(draft)
  trustLabel       TrustLabel    @default(OFFICIAL_SOURCE) @map("trust_label")
  version          Int           @default(1)
  lastVerifiedAt   DateTime?     @map("last_verified_at") @db.Timestamptz(6)
  verifiedBy       String?       @map("verified_by") @db.Uuid
  aliases          String[]      @default([])
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  agency         Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  category       ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  source         Source               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versions       ServiceVersion[]
  requirements   ServiceRequirement[]
  steps          ServiceStep[]
  offices        ServiceOffice[]
  faqs           Faq[]
  lifeEventSteps LifeEventStep[]

  @@index([categoryId])
  @@index([agencyId])
  @@index([status])
  @@map("services")
  @@schema("catalogue")
}

model ServiceVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  version       Int
  snapshot      Json
  changeSummary String?  @map("change_summary")
  authorId      String?  @map("author_id") @db.Uuid
  reviewerId    String?  @map("reviewer_id") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, version])
  @@map("service_versions")
  @@schema("catalogue")
}

model ServiceRequirement {
  id                 String   @id @default(uuid(7)) @db.Uuid
  serviceId          String   @map("service_id") @db.Uuid
  documentNameBn     String   @map("document_name_bn")
  documentNameEn     String   @map("document_name_en")
