  notesEn            String?  @map("notes_en")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_requirements")
  @@schema("catalogue")
}

model ServiceStep {
  id            String   @id @default(uuid(7)) @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  stepOrder     Int      @map("step_order")
  titleBn       String   @map("title_bn")
  titleEn       String   @map("title_en")
  instructionBn String   @map("instruction_bn")
  instructionEn String   @map("instruction_en")
  channel       String   @default("online") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stepOrder])
  @@map("service_steps")
  @@schema("catalogue")
}

model ServiceOffice {
  id         String    @id @default(uuid(7)) @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  districtId String?   @map("district_id") @db.Uuid
  upazilaId  String?   @map("upazila_id") @db.Uuid
  nameBn     String    @map("name_bn")
  nameEn     String    @map("name_en")
  addressBn  String    @map("address_bn")
  addressEn  String    @map("address_en")
  lat        Float?
  lng        Float?
  hours      String?
  contact    String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazila  Upazila?  @relation(fields: [upazilaId], references: [id], onDelete: SetNull)

  @@index([districtId])
  @@index([agencyId])
  @@map("service_offices")
  @@schema("catalogue")
}

model Notice {
  id          String        @id @default(uuid(7)) @db.Uuid
  titleBn     String        @map("title_bn")
  titleEn     String        @map("title_en")
  bodyBn      String        @map("body_bn")
  bodyEn      String        @map("body_en")
  agency      String
  kind        NoticeKind
  publishedAt DateTime      @map("published_at") @db.Timestamptz(6)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  regionScope Json          @default("{\"national\":true}") @map("region_scope")
  sourceId    String        @map("source_id") @db.Uuid
  trustLabel  TrustLabel    @default(OFFICIAL_SOURCE) @map("trust_label")
  status      ContentStatus @default(published)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([kind, publishedAt])
  @@index([expiresAt])
  @@map("notices")
  @@schema("catalogue")
}

model Faq {
  id         String     @id @default(uuid(7)) @db.Uuid
  serviceId  String?    @map("service_id") @db.Uuid
  questionBn String     @map("question_bn")
  questionEn String     @map("question_en")
  answerBn   String     @map("answer_bn")
  answerEn   String     @map("answer_en")
  sourceId   String     @map("source_id") @db.Uuid
  trustLabel TrustLabel @default(VERIFIED_BY_JONOSHHEBA) @map("trust_label")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  source  Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([serviceId])
  @@map("faqs")
  @@schema("catalogue")
}

model ContentReport {
  id           String              @id @default(uuid(7)) @db.Uuid
  reporterId   String?             @map("reporter_id") @db.Uuid
  resourceType String              @map("resource_type") @db.VarChar(48)
  resourceId   String              @map("resource_id") @db.Uuid
  reason       String              @db.VarChar(80)
  details      String
  status       ContentReportStatus @default(open)
  resolvedBy   String?             @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([resourceType, resourceId])
  @@map("content_reports")
  @@schema("catalogue")
}

model SavedItem {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  resourceType String    @map("resource_type") @db.VarChar(48)
  resourceId   String    @map("resource_id") @db.Uuid
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@map("saved_items")
  @@schema("catalogue")
}

model Reminder {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  resourceType String         @map("resource_type") @db.VarChar(48)
  resourceId   String?        @map("resource_id") @db.Uuid
  titleBn      String         @map("title_bn")
  titleEn      String         @map("title_en")
  remindAt     DateTime       @map("remind_at") @db.Timestamptz(6)
  status       ReminderStatus @default(scheduled)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  @@index([userId, remindAt])
  @@map("reminders")
  @@schema("catalogue")
}

/// R8: Verified emergency hotlines. NEVER editable without two-person review.
model Hotline {
  id                  String     @id @default(uuid(7)) @db.Uuid
  number              String     @unique @db.VarChar(24)
  nameBn              String     @map("name_bn")
  nameEn              String     @map("name_en")
  scope               String     @default("national") @db.VarChar(48)
  category            String     @db.VarChar(48)
  sourceId            String     @map("source_id") @db.Uuid
  trustLabel          TrustLabel @default(OFFICIAL_SOURCE) @map("trust_label")
  lastVerifiedAt      DateTime?  @map("last_verified_at") @db.Timestamptz(6)
  verifiedBy          String?    @map("verified_by") @db.Uuid
  secondReviewerId    String?    @map("second_reviewer_id") @db.Uuid
  verifyBeforeRelease Boolean    @default(true) @map("verify_before_release")
  sortOrder           Int        @default(0) @map("sort_order")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([category, sortOrder])
  @@map("hotlines")
  @@schema("catalogue")
}

model Facility {
  id           String       @id @default(uuid(7)) @db.Uuid
  facilityType FacilityType @map("facility_type")
  nameBn       String       @map("name_bn")
  nameEn       String       @map("name_en")
  districtId   String?      @map("district_id") @db.Uuid
  upazilaId    String?      @map("upazila_id") @db.Uuid
  addressBn    String       @map("address_bn")
  addressEn    String       @map("address_en")
  lat          Float
  lng          Float
  hours        String?
  contact      String?
  trustLabel   TrustLabel   @default(OFFICIAL_SOURCE) @map("trust_label")
  sourceId     String       @map("source_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazila  Upazila?  @relation(fields: [upazilaId], references: [id], onDelete: SetNull)
  source   Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([facilityType, districtId])
  @@index([lat, lng])
  @@map("facilities")
  @@schema("catalogue")
}

model UtilityOutage {
  id                String     @id @default(uuid(7)) @db.Uuid
  utilityType       String     @map("utility_type") @db.VarChar(32)
  providerName      String     @map("provider_name")
  districtId        String?    @map("district_id") @db.Uuid
  upazilaId         String?    @map("upazila_id") @db.Uuid
  areaDescriptionBn String     @map("area_description_bn")
  areaDescriptionEn String     @map("area_description_en")
  startsAt          DateTime   @map("starts_at") @db.Timestamptz(6)
  expectedEndAt     DateTime?  @map("expected_end_at") @db.Timestamptz(6)
  status            String     @default("active") @db.VarChar(24)
  sourceId          String     @map("source_id") @db.Uuid
  trustLabel        TrustLabel @default(OFFICIAL_SOURCE) @map("trust_label")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  upazila  Upazila?  @relation(fields: [upazilaId], references: [id], onDelete: SetNull)
  source   Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([districtId, status])
  @@map("utility_outages")
  @@schema("catalogue")
}

// =============================================================================
// 3. TRANSPORT SCHEMA (Modules 1 & 2)
// =============================================================================

model TransportProvider {
  id              String          @id @default(uuid(7)) @db.Uuid
  code            String          @unique @db.VarChar(48)
  mode            TransportMode
  name            String
  officialUrl     String          @map("official_url")
  integrationType IntegrationType @map("integration_type")
  rateLimitPerMin Int             @default(30) @map("rate_limit_per_min")
  termsUrl        String?         @map("terms_url")
  status          ProviderStatus  @default(active)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  routes             Route[]
  trips              Trip[]
  seatClasses        SeatClass[]
  inventorySnapshots InventorySnapshot[]

  @@index([mode, integrationType])
  @@map("transport_providers")
  @@schema("transport")
}

model StationStop {
  id         String        @id @default(uuid(7)) @db.Uuid
  code       String        @unique @db.VarChar(32)
  mode       TransportMode
  nameBn     String        @map("name_bn")
  nameEn     String        @map("name_en")
  districtId String?       @map("district_id") @db.Uuid
  lat        Float?
  lng        Float?
  aliases    String[]      @default([])
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(6)

  originRoutes      Route[]       @relation("RouteOrigin")
  destinationRoutes Route[]       @relation("RouteDestination")
  originWatches     TicketWatch[] @relation("WatchOrigin")
  destWatches       TicketWatch[] @relation("WatchDestination")

  @@index([mode, districtId])
  @@map("stations_stops")
  @@schema("transport")
}

model Route {
  id            String        @id @default(uuid(7)) @db.Uuid
  providerId    String        @map("provider_id") @db.Uuid
  routeKey      String        @unique @map("route_key")
  mode          TransportMode
  originId      String        @map("origin_id") @db.Uuid
  destinationId String        @map("destination_id") @db.Uuid
  nameBn        String        @map("name_bn")
  nameEn        String        @map("name_en")
  distanceKm    Int?          @map("distance_km")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  provider    TransportProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  origin      StationStop       @relation("RouteOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination StationStop       @relation("RouteDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  trips       Trip[]

  @@index([originId, destinationId, mode])
  @@map("routes")
  @@schema("transport")
}

model Trip {
  id              String    @id @default(uuid(7)) @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  providerId      String    @map("provider_id") @db.Uuid
  tripCode        String    @map("trip_code") @db.VarChar(32)
  nameBn          String    @map("name_bn")
  nameEn          String    @map("name_en")
  departTimeLocal String    @map("depart_time_local") @db.VarChar(8)
  arriveTimeLocal String    @map("arrive_time_local") @db.VarChar(8)
  operatingDays   Int[]     @default([0, 1, 2, 3, 4, 5, 6]) @map("operating_days")
  status          String    @default("active") @db.VarChar(24)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  route    Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  provider TransportProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, tripCode])
  @@index([routeId])
  @@map("trips")
  @@schema("transport")
}

model SeatClass {
  id          String   @id @default(uuid(7)) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  code        String   @db.VarChar(32)
  nameBn      String   @map("name_bn")
  nameEn      String   @map("name_en")
  baseFareBdt Int?     @map("base_fare_bdt")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider TransportProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@map("seat_classes")
  @@schema("transport")
}

/// Opt-in only search history (R9 & R10)
model JourneySearch {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  optInSaved    Boolean       @default(false) @map("opt_in_saved")
  mode          TransportMode
  originId      String        @map("origin_id") @db.Uuid
  destinationId String        @map("destination_id") @db.Uuid
  journeyDate   DateTime      @map("journey_date") @db.Date
  passengers    Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("journey_searches")
  @@schema("transport")
}

model TicketWatch {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  mode              TransportMode
  originId          String        @map("origin_id") @db.Uuid
  destinationId     String        @map("destination_id") @db.Uuid
  journeyDate       DateTime      @map("journey_date") @db.Date
  passengers        Int           @default(1)
  preferences       Json          @default("{}")
  flexibility       Json          @default("{}")
  channels          String[]      @default(["in_app", "web_push"])
  status            WatchStatus   @default(active)
  priority          Int           @default(1)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  lastCheckedAt     DateTime?     @map("last_checked_at") @db.Timestamptz(6)
  consecutiveErrors Int           @default(0) @map("consecutive_errors")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  origin      StationStop  @relation("WatchOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination StationStop  @relation("WatchDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  matches     WatchMatch[]

  @@index([userId, status])
  @@index([status, journeyDate])
  @@map("ticket_watches")
  @@schema("transport")
}

model InventorySnapshot {
  id             String            @id @default(uuid(7)) @db.Uuid
  providerId     String            @map("provider_id") @db.Uuid
  routeKey       String            @map("route_key")
  journeyDate    DateTime          @map("journey_date") @db.Date
  seatClass      String            @map("seat_class") @db.VarChar(32)
  checkedAt      DateTime          @default(now()) @map("checked_at") @db.Timestamptz(6)
  state          AvailabilityState
  seatsAvailable Int?              @map("seats_available")
  fareBdt        Int?              @map("fare_bdt")
  sourceRef      String?           @map("source_ref")
  responseStatus Int?              @map("response_status")
  rawHash        String?           @map("raw_hash") @db.VarChar(64)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  provider TransportProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  matches  WatchMatch[]

  @@index([providerId, routeKey, journeyDate, checkedAt])
  @@map("inventory_snapshots")
  @@schema("transport")
}

model WatchMatch {
  id           String       @id @default(uuid(7)) @db.Uuid
  watchId      String       @map("watch_id") @db.Uuid
  snapshotId   String       @map("snapshot_id") @db.Uuid
  matchQuality MatchQuality @map("match_quality")
  dedupeKey    String       @unique @map("dedupe_key")
  notifiedAt   DateTime?    @map("notified_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  watch    TicketWatch       @relation(fields: [watchId], references: [id], onDelete: Cascade)
  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@map("watch_matches")
  @@schema("transport")
}

/// Privacy-safe aggregate demand counts for forecasting (no PII, R10).
model DemandAggregate {
  id          String   @id @default(uuid(7)) @db.Uuid
  routeKey    String   @map("route_key")
  journeyDate DateTime @map("journey_date") @db.Date
  watchCount  Int      @default(0) @map("watch_count")
  searchCount Int      @default(0) @map("search_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([routeKey, journeyDate])
  @@map("demand_aggregates")
  @@schema("transport")
}

// =============================================================================
// 4. NOTIFY SCHEMA
// =============================================================================

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  key       String              @db.VarChar(80)
  channel   NotificationChannel
  locale    String              @default("bn") @db.VarChar(8)
  subject   String?
  body      String
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([key, channel, locale, version])
  @@map("notification_templates")
  @@schema("notify")
}

model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  titleBn   String               @map("title_bn")
  titleEn   String               @map("title_en")
  bodyBn    String               @map("body_bn")
  bodyEn    String               @map("body_en")
  category  String               @db.VarChar(48)
  priority  NotificationPriority @default(P2)
  actionUrl String?              @map("action_url")
  payload   Json                 @default("{}")
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?            @map("deleted_at") @db.Timestamptz(6)

  feedback NotificationFeedback[]

  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("notify")
}

model NotificationJob {
  id                String                @id @default(uuid(7)) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  sourceType        String                @map("source_type") @db.VarChar(48)
  sourceId          String                @map("source_id") @db.Uuid
  channel           NotificationChannel
  dedupeKey         String                @unique @map("dedupe_key")
  priority          NotificationPriority  @default(P2)
