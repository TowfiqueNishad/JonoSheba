# =============================================================================
# Jonoshheba Workers (apps/workers — BullMQ) Environment Configuration
# Handles ticket-watch fan-in polling, notification dispatch, and outbox relay.
# =============================================================================

NODE_ENV=development
APP_TIMEZONE=Asia/Dhaka
WORKER_CONCURRENCY=5
WATCH_SCHEDULER_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
OUTBOX_RELAY_ENABLED=true

DATABASE_URL=postgresql://jonoshheba:jonoshheba_dev_password_change_me@localhost:5432/jonoshheba?schema=public
REDIS_URL=redis://localhost:6379/0
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_JWT_SECRET=dev_only_replace_with_32_byte_internal_ai_shared_secret

SMS_PROVIDER=console
SMS_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_PROJECT_ID=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
