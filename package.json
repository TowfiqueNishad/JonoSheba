{
  "name": "jonoshheba",
  "version": "0.1.0",
  "private": true,
  "description": "Jonoshheba AI (জনসেবা AI) — Bangladesh's unified smart citizen-service platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=12",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter @jonoshheba/api db:migrate",
    "db:seed": "pnpm --filter @jonoshheba/api db:seed",
    "sdk:generate": "pnpm --filter @jonoshheba/sdk generate",
    "ai:dev": "uv run --directory apps/ai uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "ai:test": "uv run --directory apps/ai pytest",
    "ai:lint": "uv run --directory apps/ai ruff check .",
    "ai:typecheck": "uv run --directory apps/ai mypy app",
    "doctor": "bash scripts/doctor.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
